IMAGE=crpi-krl99lxt28fuqfvk.cn-shanghai.personal.cr.aliyuncs.com/noel-dev/camp-gallery:v2.0.0-go
PORT=8000
SECRET_KEY=请替换为随机长字符串
ADMIN_PASSWORD=请替换为管理员密码
PUBLIC_BASE_URL=http://noel-psc.cn:8000
# 可选 HTTPS（Caddy profile 或已有 nginx）。启用后把 PUBLIC_BASE_URL 改为 https://：
# PUBLIC_BASE_URL=https://noel-psc.cn
# SITE_ADDRESS=noel-psc.cn
# 如需应用层强制 HTTPS 跳转/真实客户端 IP，填 Caddy 容器 IP/CIDR；不填也能用 Caddy 终止 TLS。
# TRUSTED_PROXIES=
# 只让反代访问 8000；旧二维码仍需 8000 跳转时保持 0.0.0.0。
# BIND_ADDR=127.0.0.1
# 仅可信内网/临时测试可设为 1；公网禁止。
ALLOW_INSECURE_HTTP=0
# 默认关闭 HSTS。开启后浏览器会把 http://域名:8000 升级为 https://域名:8000；
# 若旧二维码仍在用且 8000 不是 TLS，会失败。旧二维码退役后可设 31536000。
HSTS_MAX_AGE=0
ACTIVITY_TITLE=心纹研学营
UPLOAD_DEADLINE=2026-11-19T23:59:59+08:00
MAX_UPLOAD_MB=200
MAX_CONCURRENT_UPLOADS=8
MAX_QUEUED_UPLOADS=128
MIN_FREE_DISK_MB=512
UPLOAD_TIMEOUT_SECONDS=7200
UPLOAD_BANDWIDTH_MBPS=90
DOWNLOAD_BANDWIDTH_MBPS=80
GOMEMLIMIT=512MiB
